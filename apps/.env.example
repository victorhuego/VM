# ==============================================================================
# HƯỚNG DẪN CẤU HÌNH BIẾN MÔI TRƯỜNG GOOGLE SHEETS & GOOGLE DRIVE
# ==============================================================================
# 1. Sao chép file này thành .env.local trong thư mục frontend:
#    cp .env.example .env.local
#
# 2. Điền Spreadsheet ID & Drive Folder ID:
#    - GOOGLE_SPREADSHEET_ID: Lấy từ URL của bảng tính Google Sheets:
#      https://docs.google.com/spreadsheets/d/{GOOGLE_SPREADSHEET_ID}/edit
#    - GOOGLE_DRIVE_FOLDER_ID: Lấy từ URL của thư mục Google Drive:
#      https://drive.google.com/drive/folders/{GOOGLE_DRIVE_FOLDER_ID}
#
# 3. Thông tin xác thực Google Service Account (Chọn 1 trong 2 cách):
#    CÁCH 1 (Khuyên dùng khi chạy local): Đặt file json vào frontend/credentials/service-account.json
#      GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account.json
#
#    CÁCH 2 (Khuyên dùng khi deploy Vercel / Cloud): Nhập email và private key trực tiếp
#      GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
#      GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# 4. CHIA SẺ QUYỀN (BẮT BUỘC):
#    - Mở Google Spreadsheet -> Bấm Share (Chia sẻ) -> Dán email Service Account -> Cấp quyền Editor
#    - Mở Google Drive Folder -> Bấm Share (Chia sẻ) -> Dán email Service Account -> Cấp quyền Editor
# ==============================================================================

# ID của Google Spreadsheet (bảng tính lưu trữ dữ liệu)
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# ID của thư mục Google Drive (nơi lưu trữ ảnh tải lên)
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# --- CÁCH 1: Đường dẫn file JSON credentials (Local) ---
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account.json

# --- CÁCH 2: Điền trực tiếp credentials (Deploy Cloud / Vercel) ---
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=
